# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OAuth credentials (never commit)
token.json
credentials.json
client_secret_*.json
*.apps.googleusercontent.com.json

# MCP-bundle build artifacts (large binaries; distribute via releases, not git)
*.mcpb

# Claude Code --worktree isolation dir (temp workspace; untracked by design)
.claire/

# dependencies
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python virtual environment and cache
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Archive directory for large files and historical assets
docs/archive/

# Development artifacts — dev/ is NOW tracked (session logs, reports, test harnesses
# are needed for team briefings and synthesized logs). Only archive/trash excluded.
archive/
trash/

# Test coverage reports
htmlcov/
.coverage

# Database files
*.sqlite3
*.db
data_backup/

# Redis runtime data (local persistence — recreated on each docker compose up)
data/redis/

# Learning data (runtime-mutated by app — churns on every session)
data/learning/

# Legacy flat-file GitHub preferences store — superseded by ConnectorConfigService
# (connector_configs DB table, ADR-070 D4) per WS-1 P4 (#1226/#1199). Runtime
# artifact only; noticed untracked during #1366 Component A verification.
data/github_preferences.json

# User configuration files (private, not committed)
config/PIPER.user.md
**/PIPER.user.md
*.user.md
docs/comms/blog/*.png
docs/comms/blog/*.jpg
docs/comms/blog/*.jpeg
archive/

# docs/internal/architecture/archive/ is a DELIBERATE, git-tracked destination (docs/ tree audit,
# 2026-08-01/-02) for archive-with-pointer dispositions on architecture docs — it must stay tracked
# even though the broad `archive/` rule above would otherwise silently swallow new files dropped
# there. The broad rule elsewhere (e.g. tests/archive/) is unaffected; this negates only this path.
!docs/internal/architecture/archive/
!docs/internal/architecture/archive/**

*.dmg
*.png
*.docx

# Coordination queue - keep structure but ignore local work files
coordination/claimed/*.tmp
coordination/blocked/*.tmp
advisors/*/outbox/*.tmp

# Git worktrees for multi-agent isolation
# Each agent gets an isolated worktree in .trees/<prompt-id>-<session>/
.trees/
.claude/worktrees/
.claude/*.lock
external/ted-multichat/
.beads/

# Claude Code auto-memory belongs only at ~/.claude/projects/ (absolute path) —
# a repo-relative copy here means a session wrote it with the wrong CWD
.claude/projects/

# Serena auto-generated files
.serena/project.yml
.serena/memories/working-docs/

# Alpha tester data — contains PII (names, status); not for public repos
dev/alpha/alpha-tester-roster.md
dev/alpha/host-alpha-reping-tiering*.md

# #1344 minted invite-token batches — live, valid, single-use auth secrets;
# never commit raw tokens to a public repo. Kept separate from the roster
# above (trust-zone separation: tokens and identities never share a file).
dev/alpha/invite-tokens-*.md

# PreCompact hook warnings log — ephemeral per-machine working data,
# tailed by Docs merge-keeper sweep; not for cross-machine archival.
dev/active/session-end-warnings.log

# context-usage-reminder hook throttle markers — once-per-session ephemera
dev/active/.context-usage-reminded-*

# generate-delta.py session-start helpers — regenerable per session (Lead Dev tooling), not tracked
dev/active/delta-*.md

# duty-cycle freeze-watchdog runtime audit log — appended by the launchd job, not tracked
dev/active/duty-cycle-watchdog.log
# duty-cycle freeze-watchdog nudge-state (per-role last-nudge epochs; runtime, not tracked)
dev/active/duty-cycle-watchdog-nudge-state.tsv

# Agent mailboxes — fully tracked for cross-machine sync
# (Previously ignored read/ but this prevented syncing mail state across devices)
