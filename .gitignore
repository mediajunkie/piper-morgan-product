# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OAuth credentials (never commit)
token.json
credentials.json
client_secret_*.json
*.apps.googleusercontent.com.json

# MCP-bundle build artifacts (large binaries; distribute via releases, not git)
*.mcpb

# Stray/mis-pathed agent worktree metadata (should be .claude/, not .claire/)
.claire/

# dependencies
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python virtual environment and cache
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Archive directory for large files and historical assets
docs/archive/

# Development artifacts — dev/ is NOW tracked (session logs, reports, test harnesses
# are needed for team briefings and synthesized logs). Only archive/trash excluded.
archive/
trash/

# Test coverage reports
htmlcov/
.coverage

# Database files
*.sqlite3
*.db
data_backup/

# Redis runtime data (local persistence — recreated on each docker compose up)
data/redis/

# Learning data (runtime-mutated by app — churns on every session)
data/learning/

# User configuration files (private, not committed)
config/PIPER.user.md
**/PIPER.user.md
*.user.md
docs/comms/blog/*.png
docs/comms/blog/*.jpg
docs/comms/blog/*.jpeg
archive/
*.dmg
*.png
*.docx

# Coordination queue - keep structure but ignore local work files
coordination/claimed/*.tmp
coordination/blocked/*.tmp
advisors/*/outbox/*.tmp

# Git worktrees for multi-agent isolation
# Each agent gets an isolated worktree in .trees/<prompt-id>-<session>/
.trees/
.claude/worktrees/
.claude/*.lock
external/ted-multichat/
.beads/

# Serena auto-generated files
.serena/project.yml
.serena/memories/working-docs/

# Alpha tester data — contains PII (names, status); not for public repos
dev/alpha/alpha-tester-roster.md
dev/alpha/host-alpha-reping-tiering*.md

# PreCompact hook warnings log — ephemeral per-machine working data,
# tailed by Docs merge-keeper sweep; not for cross-machine archival.
dev/active/session-end-warnings.log

# context-usage-reminder hook throttle markers — once-per-session ephemera
dev/active/.context-usage-reminded-*

# generate-delta.py session-start helpers — regenerable per session (Lead Dev tooling), not tracked
dev/active/delta-*.md

# duty-cycle freeze-watchdog runtime audit log — appended by the launchd job, not tracked
dev/active/duty-cycle-watchdog.log
# duty-cycle freeze-watchdog nudge-state (per-role last-nudge epochs; runtime, not tracked)
dev/active/duty-cycle-watchdog-nudge-state.tsv

# Agent mailboxes — fully tracked for cross-machine sync
# (Previously ignored read/ but this prevented syncing mail state across devices)
