# build-context hygiene (#1278): none of these are runtime surfaces.
# docs/ + knowledge/ + config/ + templates/ + web/static stay IN — runtime reads.
.git
.github
.claude
dev/
mailboxes/
tests/
venv/
node_modules/
*.log
.dockerignore
deploy/fly/
# #2240: an operator's local overlay must never ship in an image (alpha's or the MCP app's).
# It is gitignored, so deploy-mcp.sh's stray-file guard never saw it; this line is the backstop.
config/*.user.md
