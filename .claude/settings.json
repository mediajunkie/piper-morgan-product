{
  "env": {
    "PYTHONPATH": "/default/path",
    "NODE_ENV": "development"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch.sh",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-broad-staging-warn.sh",
            "if": "Bash(git commit*)"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-reconcile-drafts.sh",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log-maintenance-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/context-usage-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/issue-checkbox-lint.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/memory-index-overlimit-warn.sh"
          }
        ]
      }
    ],
    "PreCompact": []
  },
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(python:*)",
      "Read(//Users/xian/Downloads/**)",
      "Bash(find:*)",
      "Bash(kill:*)",
      "Bash(curl:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(timeout:*)",
      "Bash(PYTHONPATH=/Users/xian/Development/piper-morgan timeout 10s python -m uvicorn web.app:app --port 8081 --host 127.0.0.1)",
      "Read(//Users/xian/Development/**)",
      "Bash(export PYTHONPATH=:*)",
      "Bash(export PATH=:*)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(echo:*)",
      "Edit(src/**)",
      "Edit(docs/**)",
      "Bash(source :*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Edit(**/*.py)",
      "mcp__serena__search_for_pattern",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_symbol",
      "Bash(scripts/sync-pm-local.sh*)"
    ],
    "deny": [
      "Bash(rm -rf :*)",
      "Bash(sudo:*)",
      "Read(.env*)",
      "Read(secrets/**)"
    ]
  }
}
