#!/bin/sh
# Canonical source for the COMMON-DIR .git/hooks/pre-commit (covers every worktree by construction).
# Install/refresh:  cp scripts/git-hooks/pre-commit "$(git rev-parse --git-common-dir)/hooks/pre-commit"
#
# Real pre-commit gate (Arch's TOCTOU ruling, 2026-07-29): runs AFTER the index is finalised, so
# checks read settled state. Originally installed by Pard with check-branch.sh only.
# 2026-09-28 (#1798, CIO): broad-staging sweep WARNING added ahead of it. 2026-10-01: ruff warning too. It always exits 0, and its
# stderr lands in `git commit`'s own output, which the agent sees. It only runs a worktree's copy
# that carries the #1798 marker: a checkout that predates it still has the interim-BLOCK text, which
# would print a false "THIS COMMIT WAS BLOCKED". Its exit code is ignored either way (warn-only).
top="$(git rev-parse --show-toplevel)"
w="$top/.claude/hooks/pre-commit-broad-staging-warn.sh"
if [ -f "$w" ] && grep -q '#1798 RESOLVED' "$w"; then bash "$w" || true; fi
# 2026-10-01 (CIO): ruff drift warning on staged .py, same warn-only contract. It moved here from
# the post-commit shim, which has been disarmed since the 09-21 runaway. Read-only, so it can't
# recurse. Skipped in a checkout that predates the file.
r="$top/.claude/hooks/pre-commit-ruff-warn.sh"
if [ -f "$r" ]; then bash "$r" || true; fi
# 2026-11-16 (issue 2392, ADR-084 D2; CIO): the one BLOCKING check before the branch check. The
# repo is public, so a line the staged change adds with a credential shape (provider key, GitHub
# or Fly token, invite code) refuses the commit, naming file and line and never the value. A
# checkout that predates the script is passed with a line saying so; any other failure refuses.
s="$top/scripts/staged_credential_scan.py"
if [ -f "$s" ]; then
  python3 "$s" --staged --baseline "$top/.staged-credential-scan-baseline.txt" >&2 || {
    echo "pre-commit: commit refused by staged_credential_scan.py (see above)." >&2
    exit 1
  }
else
  echo "pre-commit: staged_credential_scan.py is not in this checkout; credential shapes were NOT checked." >&2
fi
exec "$top/.claude/hooks/check-branch.sh"
