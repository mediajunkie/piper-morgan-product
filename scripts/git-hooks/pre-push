#!/usr/bin/env bash
# Candidate COMMON-DIR .git/hooks/pre-push: Spec's CI-gate package item 5 (PM-approved 2026-10-04):
# "a fast smoke run before any push touching code paths; a hook, not a prose rule."
#
# STATUS: INSTALLED in the common dir (byte-identical to this file, checked 2026-10-13). Refresh:
#   cp scripts/git-hooks/pre-push "$(git rev-parse --git-common-dir)/hooks/pre-push"
#
# OLD-HISTORY GUARD (CIO, 2026-10-13, for the depth-A history rewrite; runbook step 1). Every seat
# shares one git store, so a seat that merges the rewritten origin/main into its old branch and
# pushes HEAD:main would bring the whole old history back as a fast-forward. The guard refuses any
# pushed commit that has an old-history "sentinel" commit as an ancestor. It is DORMANT until the
# sentinel file exists: "$(git rev-parse --git-common-dir)/piper-old-history-sentinels", one full
# sha per line (# comments allowed). Before the rewrite every push contains old main, so the file
# must be written only at the force-push (runbook step 5), never earlier. Best sentinel: the OLDEST
# commit the rewrite changed (from filter-repo's commit-map), since every old branch that carries
# rewritten content descends from it; add old main's tip too. PIPER_SKIP_PREPUSH_SMOKE does not
# skip it; only `git push --no-verify` does (advisory, like every hook). Refusals are logged to
# "$(git rev-parse --git-common-dir)/piper-old-history-guard.log".
#
# Coverage (CIO's condition 2, restated after Pard's env work 2026-10-04): the interpreter now
# comes from scripts/ensure-pytest-env.sh, a SHARED pinned env keyed on requirements.txt + CI's
# Python minor, provisioned once per host by Pard and verified to resolve from all 14 registered
# worktrees (see mailboxes/lead/read/reply-pard-to-lead-cio-item5-shared-env-and-the-one-line-
# that-must-not-be-copied-2026-10-04.md and finding-pard-to-lead-cio-spec-ci-skips-47-files-for-
# an-undeclared-aiosqlite-2026-10-04.md). That replaces the old 1-of-14-venvs coverage gap: this
# hook, once installed, gates all 14 worktrees, not just Lead's seat. If a seat's env resolution
# ever fails, it fails OPEN and LOUD (see below) — a miss is visible, not silent.
#
# PUSH GATES (Lead, 2026-11-12, on CIO's ruling of that day, six conditions; #2342's two reds).
# The smoke is pytest; the Code Quality and Architecture Enforcement workflows also run gates that
# are NOT pytest tests (ruff, the lint workflow's `python scripts/...` gates, the mypy ratchet).
# Two red windows on main on 11-12 came from pushes whose tests and smoke passed. So before the
# smoke, the hook runs `scripts/run-push-gates.sh --hook`:
# - Trigger: the smoke's code paths PLUS scripts/, .github/, .claude/ and the .*-baseline.txt
#   files. Two of 11-11's reds were scripts/ pushes the smoke's trigger does not match.
# - A failed gate BLOCKS the push, as a failed smoke does. Its own escape hatch is
#   PIPER_SKIP_PUSH_GATES=1 (logged), separate from PIPER_SKIP_PREPUSH_SMOKE: skipping one never
#   skips the other.
# - A gate already red on main blocks too (a seat merges main before pushing, so a red main is a
#   red tree, and the push that fixes it passes). The message says how to skip and to log why.
# - The mypy environment is never BUILT inside the hook (a network pip install at push time, per
#   worktree). If venv-mypy-gate is absent, mypy is reported UNCHECKED and the push goes on:
#   fail open and loud, like the missing pytest env.
# - The gates need no database, so they run before the smoke takes its lock.
#
# Mechanism sunset-or-renew (docs/internal/operations/mechanism-sunset-or-renew.md):
#   Cost:    Smoke: ~28s warm / ~50s cold per code-touching push. Gates: ~34s without mypy plus
#            ~7s for mypy where its environment exists (CIO's measurement, 2026-11-12), on a push
#            touching code paths, scripts/, .github/, .claude/ or a baseline file. On 11-11 the
#            smoke's trigger matched 7 of 333 commits and the gates' wider trigger 21: about 14
#            minutes a day across the cohort. ~0.5s on every other push (mail/log/docs/heartbeats
#            invoke neither).
#   Benefit: counted from the log ("$(git rev-parse --git-common-dir)/piper-prepush-smoke.log"):
#            `outcome=fail` lines are smoke failures caught before main, `outcome=gates-fail`
#            lines are gate failures caught before main, `outcome=gates-skip` lines are the
#            skips CIO counts at the review (were they reds the seat didn't cause?).
#   Review:  2026-11-29
#   Owner:   Lead
#
# Contract:
# - Runs only when the pushed range touches code paths (services/ web/ tests/ main.py alembic/
#   pytest.ini requirements*.txt). Mail (mail-send.sh pushes mailboxes/ only), logs, docs, heartbeats
#   skip it entirely, so the cohort's frequent non-code pushes pay nothing.
# - CIO's condition 1: if the working tree has uncommitted modifications or untracked files under a
#   code path, says so LOUDLY (smoke is testing the tree on disk, not strictly the pushed commit) but
#   does NOT block on it — a dirty tree is a visibility gap, not a reason to fail the push.
# - Serializes concurrent smoke runs on this host via a lock under the git common dir (flock if
#   present, a portable mkdir-lock otherwise — see pick_lock_strategy below), because the smoke
#   fixtures' unqualified DELETEs on the one shared `piper_morgan` database would otherwise eat a
#   concurrent run's rows.
# - On a code push it runs `pytest -m smoke` with CI's own addopts override (every failure shown, the
#   load-bearing --import-mode=importlib kept) and BLOCKS the push on failure: smoke is what gates CI's
#   full suite.
# - PIPER_SKIP_PREPUSH_SMOKE=1 is a loud, logged emergency skip. The hook fails open on its OWN
#   faults (no resolved interpreter, lock contention it can't clear) — a broken hook or a busy host
#   must not wedge every seat. It says so loudly instead of silently passing.
# - Appends one line per code-touching run to a log under the git common dir: timestamp, worktree,
#   interpreter resolved, code path touched, outcome (pass/fail/unchecked/emergency-skip), duration.
# - Documented test-mode knob (off by default, for exercising the fail path without editing any
#   tracked test): PIPER_PREPUSH_SMOKE_ARGS, if set, is appended verbatim to the pytest invocation
#   (e.g. a path to an untracked, smoke-marked, deliberately-failing test file). Empty/unset is a
#   no-op — routine runs are unaffected.

set -u
top="$(git rev-parse --show-toplevel)"
common="$(git rev-parse --git-common-dir)"
code_re='^(services/|web/|tests/|main\.py$|alembic/|pytest\.ini$|requirements[^/]*\.txt$)'
# The gates' trigger (CIO 2026-11-12, condition 1): the smoke's paths plus these.
gates_re='^(services/|web/|tests/|main\.py$|alembic/|pytest\.ini$|requirements[^/]*\.txt$|scripts/|\.github/|\.claude/|\.[^/]*-baseline\.txt$)'
zero=0000000000000000000000000000000000000000

pushes="$(cat)"

# --- Old-history guard (see header). Runs before everything else, on every push. ---
sentinels="$common/piper-old-history-sentinels"
if [ -f "$sentinels" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$zero" ] && continue
    while read -r s _rest; do
      case "$s" in ''|\#*) continue ;; esac
      git cat-file -e "$s^{commit}" 2>/dev/null || continue
      if git merge-base --is-ancestor "$s" "$local_sha" 2>/dev/null; then
        echo "❌ pre-push: REFUSED. $local_sha (for $remote_ref) contains pre-rewrite history (ancestor $s)." >&2
        echo "   The history was rewritten. Do not merge your old branch. In your worktree:" >&2
        echo "   git status --short   (must be empty; save anything listed), then git fetch origin && git reset --keep origin/main" >&2
        printf 'ts=%s worktree=%s ref=%s sha=%s sentinel=%s outcome=refused\n' \
          "$(date +%Y-%m-%dT%H:%M:%S%z)" "$top" "$remote_ref" "$local_sha" "$s" \
          >> "$common/piper-old-history-guard.log" 2>/dev/null
        exit 1
      fi
    done < "$sentinels"
  done <<< "$pushes"
fi

touched=""
gates_touched=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                   # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  if [ -n "$base" ] && git cat-file -e "$base" 2>/dev/null; then
    files="$(git diff --name-only "$base" "$local_sha" 2>/dev/null || true)"
  else
    files="$(git show --name-only --format= "$local_sha" 2>/dev/null || true)"
  fi
  hit="$(printf '%s\n' "$files" | grep -E "$code_re" | head -1 || true)"
  [ -n "$hit" ] && touched="$hit"
  ghit="$(printf '%s\n' "$files" | grep -E "$gates_re" | head -1 || true)"
  [ -n "$ghit" ] && gates_touched="$ghit"
done <<< "$pushes"

[ -z "$touched" ] && [ -z "$gates_touched" ] && exit 0

start_ts=$(date +%s)
logfile="$common/piper-prepush-smoke.log"

# --- Push gates (see header). Before the smoke: they need no database and no lock. ---
gates_log() {
  # gates_log <outcome> [extra]
  local when dur
  when="$(date +%Y-%m-%dT%H:%M:%S%z)"
  dur=$(( $(date +%s) - start_ts ))
  printf 'ts=%s worktree=%s code_path=%s outcome=%s duration=%ss%s\n' \
    "$when" "$top" "$gates_touched" "$1" "$dur" "${2:+ $2}" >> "$logfile" 2>/dev/null
}
if [ -n "$gates_touched" ]; then
  if [ "${PIPER_SKIP_PUSH_GATES:-}" = "1" ]; then
    echo "⚠️  pre-push gates SKIPPED by PIPER_SKIP_PUSH_GATES=1 (path touched: $gates_touched). Say why in your log." >&2
    gates_log "gates-skip"
  elif [ ! -x "$top/scripts/run-push-gates.sh" ]; then
    echo "⚠️  pre-push: scripts/run-push-gates.sh not found in this tree. Gates UNCHECKED." >&2
    gates_log "gates-unchecked" "reason=no_script"
  else
    echo "pre-push: path touched ($gates_touched) — running the CI gates (~40s)…" >&2
    gates_out="$(cd "$top" && scripts/run-push-gates.sh --hook 2>&1)"
    gates_rc=$?
    gates_summary="$(printf '%s\n' "$gates_out" | grep -E '^run-push-gates:' | tail -1)"
    printf '%s\n' "$gates_out" | grep -E '^UNCHECKED' >&2
    if [ $gates_rc -ne 0 ]; then
      printf '%s\n' "$gates_out" | grep -vE '^PASS ' >&2
      echo "❌ pre-push: a CI gate FAILED (${gates_summary:-no summary}). Push blocked: it would turn main red." >&2
      echo "   Fix it. If this gate is already red on main, it isn't your push: skip with" >&2
      echo "   PIPER_SKIP_PUSH_GATES=1 git push … and say why in your log." >&2
      gates_log "gates-fail" "summary=\"$gates_summary\""
      exit 1
    fi
    echo "pre-push: gates passed (${gates_summary#run-push-gates: })." >&2
    gates_log "gates-pass" "summary=\"$gates_summary\""
  fi
fi

[ -z "$touched" ] && exit 0

log_line() {
  # log_line <interpreter> <outcome> [extra]
  local interp="$1" outcome="$2" extra="${3:-}"
  local dur=$(( $(date +%s) - start_ts ))
  local when
  when="$(date +%Y-%m-%dT%H:%M:%S%z)"
  printf 'ts=%s worktree=%s interpreter=%s code_path=%s outcome=%s duration=%ss%s\n' \
    "$when" "$top" "${interp:-none}" "$touched" "$outcome" "$dur" "${extra:+ $extra}" \
    >> "$logfile" 2>/dev/null
}

if [ "${PIPER_SKIP_PREPUSH_SMOKE:-}" = "1" ]; then
  echo "⚠️  pre-push smoke SKIPPED by PIPER_SKIP_PREPUSH_SMOKE=1 (code path touched: $touched). Say why in your log." >&2
  log_line "" "emergency-skip"
  exit 0
fi

# CIO's condition 1: say plainly if the tree on disk disagrees with what's being pushed, under a
# code path. Warn only — never block on this.
dirty="$(git status --porcelain 2>/dev/null | cut -c4- | grep -E "$code_re" || true)"
if [ -n "$dirty" ]; then
  echo "⚠️  pre-push: smoke ran against a DIRTY tree under code paths: $(printf '%s' "$dirty" | tr '\n' ' ' | sed 's/ *$//')" >&2
fi

py="$("$top/scripts/ensure-pytest-env.sh" 2>/dev/null)"
if [ -z "$py" ] || [ ! -x "$py" ]; then
  echo "⚠️  pre-push: pytest env not provisioned — run scripts/ensure-pytest-env.sh --build or ask Pard. Pushing UNCHECKED." >&2
  log_line "" "unchecked"
  exit 0
fi

# --- Serialize concurrent smoke runs on this host (shared Postgres 5433 under smoke fixtures) ---
lock_wait=120     # seconds to wait for a concurrent run to finish before giving up
lock_stale=300    # seconds after which an abandoned lock is treated as stale and cleared
lock_strategy="mkdir"
lock_acquired=0

if command -v flock >/dev/null 2>&1; then
  lock_strategy="flock"
  lockfile="$common/piper-prepush-smoke.flock"
  exec 9>"$lockfile" 2>/dev/null
  if flock -w "$lock_wait" 9 2>/dev/null; then
    lock_acquired=1
  fi
else
  # Portable fallback: no flock binary on this host (confirmed on Amber/macOS — `command -v
  # flock` fails, there is no bundled equivalent). mkdir is atomic across POSIX filesystems, so
  # it's a correct mutex primitive; we add a bounded wait and a stale-lock timeout so an abandoned
  # lock (hook killed mid-run) can't wedge every future push.
  lockdir="$common/piper-prepush-smoke.lock"
  waited=0
  while true; do
    if mkdir "$lockdir" 2>/dev/null; then
      lock_acquired=1
      break
    fi
    age=0
    if [ -d "$lockdir" ]; then
      mtime="$(stat -f %m "$lockdir" 2>/dev/null || stat -c %Y "$lockdir" 2>/dev/null || echo "")"
      [ -n "$mtime" ] && age=$(( $(date +%s) - mtime ))
    fi
    if [ "$age" -ge "$lock_stale" ]; then
      echo "pre-push: clearing stale smoke lock (age ${age}s) at $lockdir" >&2
      rmdir "$lockdir" 2>/dev/null
      continue
    fi
    if [ "$waited" -ge "$lock_wait" ]; then
      break
    fi
    sleep 2
    waited=$((waited + 2))
  done
fi

if [ "$lock_acquired" -ne 1 ]; then
  echo "⚠️  pre-push: could not acquire smoke lock within ${lock_wait}s (another push's smoke may still be running) — pushing UNCHECKED." >&2
  log_line "$py" "unchecked" "lock_strategy=$lock_strategy lock_timeout"
  exit 0
fi

cleanup() {
  if [ "$lock_strategy" = "mkdir" ]; then
    rmdir "$common/piper-prepush-smoke.lock" 2>/dev/null
  fi
  # flock's lock releases automatically when fd 9 closes at process exit; nothing to do here.
}
trap cleanup EXIT

echo "pre-push: code path touched ($touched) — running the smoke set (~1 min, lock=$lock_strategy)…" >&2
out="$(cd "$top" && POSTGRES_PORT="${POSTGRES_PORT:-5433}" "$py" -m pytest -m smoke -q --tb=line -p no:cacheprovider \
  -o addopts="--ignore=tests/archive --ignore=*/archive/* --ignore=services/integrations/*/tests --ignore=services/mcp/server/test_*.py --ignore=dev/ --import-mode=importlib" \
  ${PIPER_PREPUSH_SMOKE_ARGS:-} 2>&1)"
rc=$?
summary="$(printf '%s\n' "$out" | grep -E '[0-9]+ (passed|failed)' | tail -1)"
if [ $rc -ne 0 ]; then
  printf '%s\n' "$out" | grep -E '^(FAILED|ERROR) ' >&2
  echo "❌ pre-push: smoke FAILED ($summary). Push blocked — CI's full suite would be skipped behind a red smoke." >&2
  echo "   Fix it, or (emergency only) PIPER_SKIP_PREPUSH_SMOKE=1 git push … and log why." >&2
  log_line "$py" "fail" "lock_strategy=$lock_strategy summary=\"$summary\""
  exit 1
fi
echo "pre-push: smoke passed ($summary)." >&2
log_line "$py" "pass" "lock_strategy=$lock_strategy summary=\"$summary\""
exit 0
