+# PM live (alpha v169, 2026-10-05): "Mark the first three complete and leave
+# the fourth one pending." A COUNT after first/last is a RANGE over the same
+# due-reminder candidates, not a single position — the single-position
+# binder took "first" and completed one. Narrow on purpose: first/last + a
+# small cardinal; "all" is not claimed here (it belongs to the clear family).
+_CARDINAL_WORDS = {
+    "two": 2,
+    "three": 3,
+    "four": 4,
+    "five": 5,
+    "six": 6,
+    "seven": 7,
+    "eight": 8,
+    "nine": 9,
+    "ten": 10,
+}
+_ORDINAL_RANGE_RE = re.compile(
+    r"\b(first|last)\s+(two|three|four|five|six|seven|eight|nine|ten|\d{1,2})\b",
+    re.IGNORECASE,
+)
+
+
+def _ordinal_range(text: str, n: int) -> Optional[List[int]]:
+    """'the first three' / 'last 2' -> 0-based positions over ``n``
+    candidates (clamped to what exists), or None when no range is named."""
+    m = _ORDINAL_RANGE_RE.search(text)
+    if not m or n < 1:
+        return None
+    raw = m.group(2).lower()
+    count = _CARDINAL_WORDS.get(raw) or (int(raw) if raw.isdigit() else 0)
+    if count < 1:
+        return None
+    count = min(count, n)
+    if m.group(1).lower() == "first":
+        return list(range(count))
+    return list(range(n - count, n))
+
