+def _bind_named_targets(named: List[str], candidates: List[Any]) -> Tuple[List[Any], List[str]]:
+    """Bind each quoted name to the candidates it names. An exact (case-
+    insensitive) text match binds EVERY candidate carrying that text — two
+    reminders both called 'check the test card again' are both meant when
+    the user names it (PM's live set, 2026-10-05). Otherwise a unique
+    substring match either way binds one. Returns (bound, unmatched names);
+    a name matching several DIFFERENT texts is unmatched (never guessed)."""
+    bound: List[Any] = []
+    unmatched: List[str] = []
+    seen = set()
+    for raw in named:
+        name = raw.strip().strip(",").strip().lower()
+        if not name:
+            continue
+        exact = [c for c in candidates if (c.text or "").strip().lower() == name]
+        if not exact:
+            partial = [
+                c
+                for c in candidates
+                if name in (c.text or "").lower() or (c.text or "").strip().lower() in name
+            ]
+            if len({(c.text or "").strip().lower() for c in partial}) == 1:
+                exact = partial
+        if not exact:
+            unmatched.append(raw.strip().strip(","))
+            continue
+        for c in exact:
+            if c.id not in seen:
+                seen.add(c.id)
+                bound.append(c)
+    return bound, unmatched
+
+
+async def _apply_verb_to_named_targets(
+    intent_service,
