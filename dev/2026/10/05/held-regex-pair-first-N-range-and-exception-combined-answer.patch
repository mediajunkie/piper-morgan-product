+    """Exception-clause answer that carries the explicit list: store the
+    verb (the question promised "I'll remember"), then act on exactly the
+    named candidates — complete directly (WRITE), or arm the #1190 delete
+    confirm for just those (DESTRUCTIVE; nothing deleted this turn). Returns
+    None when no name binds, so the caller keeps its "tell me which" reply."""
+    from services.intent_service.verified_inference import (
+        SOURCE_USER_VERIFIED,
+        store_verified_inference,
+    )
+
+    try:
+        user_uuid = UUID(str(principal))
+    except (ValueError, TypeError):
+        return None
+    todo_service = intent_service.todo_handlers.todo_service
+    candidates = await _resolve_targets(todo_service, user_uuid, noun)
+    bound, unmatched = _bind_named_targets(named, candidates)
+    if not bound:
+        return None
+
+    persisted = await store_verified_inference(
+        principal, key, value, source=SOURCE_USER_VERIFIED, confidence=VERB_CONFIDENCE
+    )
+    verb_meaning = "delete" if value == VALUE_DELETE else "mark done"
+    lead = f"Got it — '{verb}' means {verb_meaning}, and I'll remember that."
+    if not persisted:
+        lead += " (Heads up: I couldn't save that preference just now, so I may ask again.)"
+    ids = [c.id for c in bound]
+    texts = [c.text for c in bound]
+    missing = ""
+    if unmatched:
+        quoted = ", ".join(f"'{n}'" for n in unmatched)
+        missing = f"\nI couldn't find a {noun} called {quoted} — nothing was changed for that."
+
+    if value == VALUE_DELETE:
+        question = variant_three_question(len(ids), verb, noun)
