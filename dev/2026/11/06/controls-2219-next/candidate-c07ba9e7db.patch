diff --git a/tests/unit/services/intent_service/test_next_todo_own_op_2219.py b/tests/unit/services/intent_service/test_next_todo_own_op_2219.py
new file mode 100644
index 0000000000..9a7859ddd6
--- /dev/null
+++ b/tests/unit/services/intent_service/test_next_todo_own_op_2219.py
@@ -0,0 +1,51 @@
+"""#2219 (Arch ruling, decisions.log 2026-11-06 07:07, option (a)): "what's my next
+todo?" is its own router operation, not an alias the list op swallows.
+
+Before the split, ``next_todo_query`` shared the todo list's rail entry, so the
+grammar collapsed it into ``list_todos_query`` and the router could only answer
+"next" with the whole list (PA's Q57).
+"""
+
+from services.intent_service.action_mapper import ActionMapper
+from services.intent_service.inversion_router import derive_routing_grammar
+from services.intent_service.router_catalog_order import CATALOG_ORDER_LEDGER
+from services.intent_service.workflow_dispatcher import get_action_workflows
+from services.intent_service.workflow_entries import register_default_workflows
+
+
+def _ops():
+    return {op.name: op for op in derive_routing_grammar().operations}
+
+
+def test_next_todo_is_a_canonical_operation_with_no_aliases():
+    ops = _ops()
+    assert "next_todo_query" in ops
+    assert ops["next_todo_query"].aliases == ()
+    assert ops["next_todo_query"].description == "next todo query"
+
+
+def test_the_list_op_no_longer_claims_next():
+    op = _ops()["list_todos_query"]
+    assert "next_todo_query" not in op.aliases
+    assert op.aliases == ("list_completed_todos",)
+    assert "next" not in op.description
+
+
+def test_the_split_is_appended_to_the_order_ledger():
+    # Append-only: the new op takes the last slot, so no existing line moves.
+    assert CATALOG_ORDER_LEDGER[-1] == "next_todo_query"
+    assert CATALOG_ORDER_LEDGER.count("next_todo_query") == 1
+
+
+def test_next_todo_has_its_own_read_entry_on_the_same_adapter():
+    register_default_workflows()
+    wf = get_action_workflows()
+    nxt, lst = wf["next_todo_query"], wf["list_todos_query"]
+    assert nxt is not lst
+    assert nxt.entry_point is lst.entry_point
+    assert nxt.effect == lst.effect
+    assert nxt.flip_group == "read_status"
+
+
+def test_next_todo_query_still_maps_to_the_next_todo_handler():
+    assert ActionMapper.map_action("next_todo_query") == "next_todo"
